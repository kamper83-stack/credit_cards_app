# Copy to /etc/nginx/sites-available/rewards-app, edit <TAILSCALE_IP> and
# <APP_PATH>, then: ln -s /etc/nginx/sites-available/rewards-app /etc/nginx/sites-enabled/
#
# Listening only on the Tailscale interface IP (not 0.0.0.0) means this
# vhost never binds to the VPS's public interface at all.
server {
    listen <TAILSCALE_IP>:80;
    server_name _;

    root <APP_PATH>/client/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:3001/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # nginx is the edge (first hop) here, so OVERWRITE X-Forwarded-For with the real
        # peer address instead of appending ($proxy_add_x_forwarded_for) - otherwise a
        # client-supplied header would be passed through. If another proxy sits in front
        # of this nginx, use $proxy_add_x_forwarded_for and trust that hop in the app.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite (never pass through) X-Forwarded-Host with the Host the client sent, port included;
        # the app's CSRF check treats it as an additional own host when the peer is a trusted proxy.
        proxy_set_header X-Forwarded-Host $http_host;
        # Per-user data must not be cached anywhere. The app already sends no-store; hide the
        # upstream copy and set it here so the header appears exactly once (also on errors).
        proxy_hide_header Cache-Control;
        proxy_hide_header Pragma;
        add_header Cache-Control "no-store" always;
        add_header Pragma "no-cache" always;
        include <APP_PATH>/deploy/nginx-security-headers.conf;
    }

    # Content-hashed build output: cache for a year.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include <APP_PATH>/deploy/nginx-security-headers.conf;
    }

    # The statically served HTML bypasses Express, so send the security headers here (shared snippet;
    # repeated in each location below because nginx drops inherited add_header when a location sets its own).
    include <APP_PATH>/deploy/nginx-security-headers.conf;

    # index.html (and the SPA fallback) must be revalidated on every load so a deploy is picked up.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include <APP_PATH>/deploy/nginx-security-headers.conf;
    }
}
