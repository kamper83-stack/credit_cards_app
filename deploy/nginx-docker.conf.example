# Host nginx in front of the Docker container (docker-compose publishes 127.0.0.1:3006 -> 3000).
# Example for https://rewards.erankam.dev. The Node app serves the SPA and the API and already sends
# the security headers (CSP, nosniff, Referrer-Policy, HSTS in production) and `Cache-Control: no-store`
# on /api, so nginx only has to proxy correctly. Do NOT add the same headers here again (duplicates).
#
# Install:  sudo cp deploy/nginx-docker.conf.example /etc/nginx/sites-available/rewards
#           (adjust server_name / certificate paths)  ->  sudo ln -s ... sites-enabled/
#           sudo nginx -t && sudo systemctl reload nginx
# Certificate (if none yet):  sudo certbot --nginx -d rewards.erankam.dev

server {
    listen 80;
    listen [::]:80;
    server_name rewards.erankam.dev;
    return 301 https://$host$request_uri;
}

server {
    # `ssl http2` works on nginx 1.18+ (newer versions only log a deprecation warning). On nginx
    # >= 1.25.1 you can instead use `listen 443 ssl;` + `listen [::]:443 ssl;` and a separate `http2 on;`.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name rewards.erankam.dev;

    ssl_certificate     /etc/letsencrypt/live/rewards.erankam.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rewards.erankam.dev/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # The API only accepts small JSON bodies (100 kb in Express). Reject anything larger at the edge.
    client_max_body_size 256k;

    # Do not leak the nginx version.
    server_tokens off;

    location / {
        proxy_pass http://127.0.0.1:3006;
        proxy_http_version 1.1;

        # CSRF compares Origin with Host: pass the ORIGINAL Host and overwrite (never append to)
        # the forwarded headers. nginx is the first hop, so $remote_addr is the real client.
        # If a CDN/proxy (e.g. Cloudflare) sits in front of this nginx, configure real_ip first
        # (ngx_http_realip_module) so $remote_addr is the visitor, not the CDN.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_read_timeout 120s;   # a RiseUp sync can take up to RISEUP_MCP_TIMEOUT_MS (90 s)
        proxy_send_timeout 30s;

        # Per-user data must not be cached by any layer; the app already sends no-store on /api and
        # the right Cache-Control on the SPA files, so leave the upstream headers untouched.
    }
}
