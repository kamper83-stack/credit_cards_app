# Single reference for every environment variable the server reads (grep process.env in server/src).
# Everything is optional for local development on a fresh database; see README.md.
#
# Where to put the file:
#   dev / pm2   -> server/.env      (dotenv loads it from the server's working directory)
#   Docker      -> .env next to docker-compose.yml (chmod 600). Compose reads it and passes through
#                  ONLY the variables listed in docker-compose.yml; PORT, HOST, NODE_ENV, TZ are set there.
# Never commit the real file (it is in .gitignore). Quote values that contain `$` or spaces.

# ---------------------------------------------------------------------------------------------
# 1. Server basics
# ---------------------------------------------------------------------------------------------
# PORT=3001
# Bind address. Behind a reverse proxy on the same host use 127.0.0.1 so the API is never reachable
# directly. (The Docker image sets HOST=0.0.0.0 inside the container; the compose file publishes
# the port on 127.0.0.1 only.)
# HOST=127.0.0.1
# production enables HSTS and defaults COOKIE_SECURE to true. Set by the Docker image / pm2 config.
# NODE_ENV=production
# SQLite file (default: data/rewards.db at the repo root, /app/data/rewards.db in Docker). Tests use ':memory:'.
# DB_PATH=/var/lib/credit_cards_app/rewards.db

# ---------------------------------------------------------------------------------------------
# 2. Reverse proxy, cookies, CSRF
# ---------------------------------------------------------------------------------------------
# Which peers may set X-Forwarded-For/Proto/Host (client IP for rate limits, https detection).
# Default 'loopback': only a proxy on the same host (nginx -> 127.0.0.1).
# Docker behind host nginx: 'loopback,linklocal,uniquelocal' (the bridge gateway is a private address;
# set in docker-compose.yml). Direct exposure with no proxy: 'false'.
# Avoid bare hop counts (e.g. 1) when HOST=0.0.0.0: direct clients could spoof X-Forwarded-For.
# TRUST_PROXY=loopback

# Session cookie mode. true => cookie `__Host-sid` with the Secure flag (HTTPS only: browsers drop
# Secure cookies received over plain http). false => cookie `sid`, no Secure flag.
# Default: true when NODE_ENV=production, otherwise false. A production deployment served over plain
# HTTP (e.g. a Tailscale IP without TLS) MUST set COOKIE_SECURE=false or login appears to succeed but
# the cookie is never stored. Behind nginx also forward Host and X-Forwarded-Proto.
# COOKIE_SECURE=true

# CSRF: state-changing /api requests need an Origin (or Referer) equal to the request Host. Extra allowed
# origins, comma-separated full origins. Not needed when nginx forwards the original Host (same origin).
# ALLOWED_ORIGINS=https://rewards.example.com
# Only when the SPA is served from a different origin than the API (enables CORS; also allowed by CSRF).
# In dev the Vite proxy makes requests same-origin, so leave it unset.
# CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------------------------
# 3. Secrets: RiseUp token encryption (AES-256-GCM at rest)
# ---------------------------------------------------------------------------------------------
# Exactly 32 bytes, base64 (44 chars) or hex (64 chars). Generate:  openssl rand -base64 32
# REQUIRED as soon as the database holds a RiseUp token (the server refuses to start without it) and
# to save a token at all. A fresh install can start without it, but RiseUp sync will answer 500 until
# it is set. Keep a copy OUTSIDE the DB and its backups (password manager): without it stored tokens
# are unreadable. See deploy/DEPLOY.md.
# TOKEN_ENC_KEY=
# Rotation: new key -> TOKEN_ENC_KEY, old key -> TOKEN_ENC_KEY_PREV, bump TOKEN_ENC_KEY_VERSION
# (default 1), restart, wait for the 'N rows re-encrypted' log line, then remove TOKEN_ENC_KEY_PREV.
# TOKEN_ENC_KEY_VERSION=1
# TOKEN_ENC_KEY_PREV=

# ---------------------------------------------------------------------------------------------
# 4. First-run admin (REQUIRED on the first start of a fresh database; also for legacy upgrades)
# ---------------------------------------------------------------------------------------------
# Registration is invite-only, so a fresh database has no way to get its first (admin) user except
# these variables: with zero users and no ADMIN_*, a production start (NODE_ENV=production, as in
# Docker) aborts; dev/test only logs a warning and nobody can log in. On a legacy upgrade the cards
# are assigned to this account. ADMIN_PASSWORD (min 12 characters) is used ONCE: remove it from the
# environment after the first successful start. Once any user exists these variables are ignored.
# (Users but no admin: npm run promote-admin --workspace=server -- <email>.)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Alternative to ADMIN_PASSWORD: path to a file containing the password (trailing newline stripped;
# set only one of the two). In Docker the file must be mounted into the container.
# ADMIN_PASSWORD_FILE=
# The upgrade leaves rewards.db.bak-<timestamp> next to the DB; it holds the OLD PLAINTEXT token.
# Delete it once you have verified the app works.

# ---------------------------------------------------------------------------------------------
# 5. Rate limits (defaults shown). 429 on excess. /api/health is exempt from the general limit.
# ---------------------------------------------------------------------------------------------
# General /api limit per IP.
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=900000
# Login.
# LOGIN_RATE_LIMIT_IP_MAX=20              # per IP
# LOGIN_RATE_LIMIT_EMAIL_MAX=10           # per (normalized email + IP)
# LOGIN_RATE_LIMIT_EMAIL_GLOBAL_MAX=100   # per email across all IPs: high backstop only
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Registration.
# REGISTER_RATE_LIMIT_MAX=10              # per IP
# REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# Registration is invite-only; failed invite attempts (unknown/expired/revoked/exhausted) per IP:
# Users behind one shared IP share this budget: failures of one can 429 a valid invite; raise it if so.
# INVITE_FAIL_RATE_LIMIT_MAX=10
# INVITE_FAIL_RATE_LIMIT_WINDOW_MS=3600000

# ---------------------------------------------------------------------------------------------
# 6. RiseUp sync
# ---------------------------------------------------------------------------------------------
# RISEUP_MAX_CONCURRENT=3                 # simultaneous MCP subprocesses server-wide (per user is always 1)
# RISEUP_MCP_TIMEOUT_MS=90000             # abort a RiseUp call that takes longer
# RISEUP_USER_RATE_LIMIT_MAX=5            # token checks + syncs per user ...
# RISEUP_USER_RATE_LIMIT_WINDOW_MS=900000 # ... per window
# RISEUP_TOKEN_COOLDOWN_MS=30000          # wait after a failed token check
# The MCP child only inherits RISEUP_PAT plus HTTP(S)_PROXY / NO_PROXY / ALL_PROXY, NODE_EXTRA_CA_CERTS,
# SSL_CERT_FILE and TMPDIR/TEMP/TMP from the environment (never the secrets above).
