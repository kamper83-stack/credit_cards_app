PORT=3001
# Only set CLIENT_URL if the client is served from a different origin (enables CORS).
# In dev the Vite proxy makes requests same-origin, so it is not needed.
# CLIENT_URL=http://localhost:5173

# Production (VPS behind nginx): bind the API only to localhost so it's
# never reachable directly, only through the nginx reverse proxy.
# HOST=127.0.0.1

# Path to the SQLite database (default: data/rewards.db at repo root).
# Tests use ':memory:'.
# DB_PATH=/var/lib/credit_cards_app/rewards.db

# Which peers may set X-Forwarded-For (used for client IP / rate limiting).
# Default 'loopback': only a proxy on the same host (nginx -> 127.0.0.1).
# Docker behind host nginx: 'loopback,linklocal,uniquelocal' (bridge gateway is private).
# Direct exposure with no proxy: 'false'. Avoid bare hop counts (e.g. 1) when HOST=0.0.0.0:
# direct clients could then spoof X-Forwarded-For and bypass the rate limit.
# TRUST_PROXY=loopback

# General /api rate limit per IP (/api/health is exempt) (defaults: 300 requests per 15 minutes).
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=900000
