PORT=3001
# Only set CLIENT_URL if the client is served from a different origin (enables CORS).
# In dev the Vite proxy makes requests same-origin, so it is not needed.
# CLIENT_URL=http://localhost:5173

# Production (VPS behind nginx): bind the API only to localhost so it's
# never reachable directly, only through the nginx reverse proxy.
# HOST=127.0.0.1

# Path to the SQLite database (default: data/rewards.db at repo root).
# Tests use ':memory:'.
# DB_PATH=/var/lib/credit_cards_app/rewards.db

# Which peers may set X-Forwarded-For (used for client IP / rate limiting).
# Default 'loopback': only a proxy on the same host (nginx -> 127.0.0.1).
# Docker behind host nginx: 'loopback,linklocal,uniquelocal' (bridge gateway is private).
# Direct exposure with no proxy: 'false'. Avoid bare hop counts (e.g. 1) when HOST=0.0.0.0:
# direct clients could then spoof X-Forwarded-For and bypass the rate limit.
# TRUST_PROXY=loopback

# General /api rate limit per IP (/api/health is exempt) (defaults: 300 requests per 15 minutes).
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=900000

# --- Multi-user / secrets (phase 2) ---
# AES-256-GCM key encrypting RiseUp tokens at rest. Exactly 32 bytes, base64 or hex.
# Generate with:  openssl rand -base64 32
# Required if the DB holds a RiseUp token (the server refuses to start without it).
# TOKEN_ENC_KEY=
# Key rotation: new key -> TOKEN_ENC_KEY, old key -> TOKEN_ENC_KEY_PREV, bump TOKEN_ENC_KEY_VERSION
# (default 1), restart, wait for the 'N rows re-encrypted' log line, then remove TOKEN_ENC_KEY_PREV.
# Back the key up somewhere other than the DB. See deploy/DEPLOY.md.
# TOKEN_ENC_KEY_VERSION=1
# TOKEN_ENC_KEY_PREV=

# First-run admin account. Needed when upgrading a pre-multi-user database (it becomes the
# owner of all existing cards/data). ADMIN_PASSWORD (min 12 chars) is only used on that first
# run: remove it from the environment afterwards.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Alternative to ADMIN_PASSWORD: path to a file containing the password (trailing newline stripped).
# ADMIN_PASSWORD_FILE=
# The upgrade leaves rewards.db.bak-<timestamp> next to the DB; it holds the OLD PLAINTEXT token.
# Delete it once you have verified the app works.
